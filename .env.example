# Claude API key — enables photo analysis, the AI coach's conversational mode and AI program notes.
# Without it, every non-AI feature still works and AI features show a clear "not configured" state.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5-5)
APEX_MODEL=claude-opus-5-5
# 32-byte key (64 hex chars) used to encrypt stored photos with AES-256-GCM.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APEX_ENCRYPTION_KEY=
# Where the SQLite database and encrypted photos live
APEX_DATA_DIR=./storage
